# Logs
*.log
logs/pick_stack/
logs/camera/

# Regenerable IK seed table (control/ik.py rebuilds it in ~13s from the URDF)
src/configs/calib/ik_seed_table.npz

# Scratch/throwaway previews (the leading underscore marks intent: never commit)
**/_preview_*

# Test caches
.pytest_cache/

# Docker build staging (model checkpoints)
models/

# Live session IPC and telemetry
/var/

# Local report source materials
/docs/report/Chats/
/docs/report/reference/

# LLM agent transcripts, runtime lock, and API keys
logs/agent/
.env

# Timestamped calibration backups are local recovery artifacts.
src/configs/calib/*.pre-*.json

# Agent UI build dependencies (compiled browser assets are tracked).
frontend/node_modules/
frontend/.build/

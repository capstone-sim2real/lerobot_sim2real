# so101-agent LLM API keys.
#
# Copy this file to .env (in the repo root, or wherever you launch
# so101-agent from) and fill in the key for whichever provider
# agent.provider/fallback_provider name in src/configs/default.yaml.
# so101-agent loads .env automatically on startup -- no `export` needed.
#
# A real `export FOO=...` in your shell always wins over this file.

# Default provider (agent.provider: openai, model: gpt-5.6-luna)
OPENAI_API_KEY=

# Default fallback (agent.fallback_provider: gemini)
GEMINI_API_KEY=

# Only needed if you switch agent.provider (or pass --provider):
# ANTHROPIC_API_KEY=
